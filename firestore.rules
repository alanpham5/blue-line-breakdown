rules_version = '2';

// Blue Line Breakdown — Firestore security rules.
//
// Collections:
//   users/{uid}                      — per-user profile root (owner-only)
//   users/{uid}/bookmarks/{markId}   — saved players/teams (owner-only)
//   users/{uid}/drafts/{draftId}     — saved expansion drafts, in-progress +
//                                      completed (owner-only, private)
//   expansion_drafts/{draftId}       — public community leaderboard
//
// Principles:
//   • A user may only read/write documents under their own users/{uid} tree.
//   • Anyone may READ the leaderboard.
//   • Only an authenticated user with a VERIFIED email may CREATE a leaderboard
//     entry, and only as themselves (ownerId == their uid).
//   • Likes can be toggled by any signed-in user, but ONLY the `likes` and
//     `likedBy` fields may change — the rest of the document is immutable.
//   • Only the owner may delete their own draft.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function emailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // ---- Users + their bookmarks (owner-only) ----
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /bookmarks/{markId} {
        allow read, write: if isOwner(uid);
      }

      // Saved expansion drafts (in-progress autosaves + completed franchises).
      // Private to the owner; no email-verification gate since nothing here is
      // public.
      match /drafts/{draftId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ---- Community leaderboard ----
    // Entry id == the owner's saved-draft id. A post is therefore always a
    // public projection of a real, owned draft, and a draft can have at most
    // one entry.
    match /expansion_drafts/{draftId} {
      // Public read.
      allow read: if true;

      // Create requires a verified email and self-ownership; the entry must
      // reference (by id) a saved draft the creator actually owns, so a post
      // can never point at a missing or another user's draft. Likes must start
      // at zero so the leaderboard can't be seeded with inflated counts.
      allow create: if emailVerified()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.draftId == draftId
        && request.resource.data.likes == 0
        && request.resource.data.season is number
        && request.resource.data.teamName is string
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/drafts/$(draftId));

      // Any signed-in user may toggle a like, but only the likes/likedBy fields
      // may change — and the actor may only add/remove THEIR OWN uid.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['likes', 'likedBy'])
        && request.resource.data.likedBy.hasOnly(
             resource.data.likedBy.concat([request.auth.uid]))
        && (request.auth.uid in request.resource.data.likedBy
            || request.auth.uid in resource.data.likedBy);

      // Only the owner may delete their submission.
      allow delete: if isOwner(resource.data.ownerId);
    }
  }
}
