rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function emailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /bookmarks/{markId} {
        allow read, write: if isOwner(uid);
      }

      match /drafts/{draftId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /expansion_drafts/{draftId} {
      allow read: if true;

      allow create: if emailVerified()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.draftId == draftId
        && request.resource.data.likes == 0
        && request.resource.data.season is number
        && request.resource.data.teamName is string
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/drafts/$(draftId));

      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['likes', 'likedBy'])
        && request.resource.data.likedBy.hasOnly(
             resource.data.likedBy.concat([request.auth.uid]))
        && (request.auth.uid in request.resource.data.likedBy
            || request.auth.uid in resource.data.likedBy);

      allow delete: if isOwner(resource.data.ownerId);
    }

    match /auth_tokens/{tokenId} {
      allow read: if true;
      allow write: if false;
    }

    // Outgoing email queue for the Firebase "Trigger Email" extension.
    // Written only by the Admin SDK (which bypasses these rules); never exposed
    // to clients since documents contain recipient addresses and link tokens.
    match /mail/{docId} {
      allow read, write: if false;
    }
  }
}
