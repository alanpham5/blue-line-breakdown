REACT_APP_API_URL=https://blue-line-breakdown-api.onrender.com

# App public URL (used to build OAuth redirect URIs and email links)
REACT_APP_APP_URL=http://localhost:3000

# Google OAuth — Client ID is safe to expose in the browser.
# Client Secret is server-side only (no REACT_APP_ prefix).
REACT_APP_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Firebase — Web SDK (browser). Create a Web App in the Firebase console
# and copy the config values here. See SETUP.md for the full walkthrough.
# authDomain can stay as the Firebase default — the Google consent screen
# now goes through Cloud Console only, not through Firebase.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=blue-line-breakdown-afaf2.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Firebase Admin SDK — server only (Vercel serverless functions).
# Base64-encode your service account JSON:
#   base64 -i serviceAccount.json | tr -d '\n'
# Paste the result here. Never commit this value.
FIREBASE_SERVICE_ACCOUNT_B64=

# Email delivery — Firebase "Trigger Email from Firestore" extension.
# SMTP credentials and the default FROM address are configured on the extension
# itself (Gmail SMTP — no custom domain needed). See SETUP.md. The app only needs
# these optional overrides; both have sensible defaults.
#
# Firestore collection the extension watches (must match the extension config).
MAIL_COLLECTION=mail
# Optional per-message FROM. Leave blank to use the extension's default sender.
EMAIL_FROM=
